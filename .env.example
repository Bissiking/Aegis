# Aegis configuration — copy to /etc/aegis/aegis.env and adjust.
# Format: KEY=value, one per line. Lines starting with # are ignored.
# The file is read by `aegis` when AEGIS_CONFIG points at it.

# ---------------------------------------------------------------- core
# production | development
AEGIS_ENV=production
AEGIS_LISTEN=127.0.0.1:8443
AEGIS_PUBLIC_URL=https://vpn.example.com

# Required in production: at least 32 characters of random data.
# Generate with:  openssl rand -base64 48
AEGIS_SESSION_SECRET=

AEGIS_DATA_DIR=/var/lib/aegis
AEGIS_DATABASE_PATH=/var/lib/aegis/aegis.db
AEGIS_FRONTEND_DIR=/usr/share/aegis/web

# Session lifetimes (Go duration syntax, e.g. 12h, 2h30m)
AEGIS_SESSION_TTL=12h
AEGIS_SESSION_IDLE_TTL=2h

# Set to true only when a reverse proxy terminates TLS and sets X-Forwarded-*.
AEGIS_TRUST_PROXY=false
# Set to false when TLS is terminated by a reverse proxy in front of Aegis.
AEGIS_COOKIE_SECURE=true
AEGIS_COOKIE_NAME=aegis_session
AEGIS_CSRF_COOKIE=aegis_csrf

# ---------------------------------------------------------- local login
AEGIS_LOCAL_AUTH_ENABLED=true
# First run creates this administrator when the database is empty.
# Remove the password line after the first successful login.
AEGIS_BOOTSTRAP_USER=admin@example.org
AEGIS_BOOTSTRAP_PASSWORD=

# Argon2id parameters (OWASP-aligned defaults).
AEGIS_ARGON_TIME=3
AEGIS_ARGON_MEMORY=65536
AEGIS_ARGON_THREADS=2
AEGIS_ARGON_KEYLEN=32

AEGIS_LOGIN_RATE_LIMIT=10
AEGIS_API_RATE_LIMIT=300

# ---------------------------------------------------------------- kyros
# Generic OIDC adapter. Nothing here is assumed: fill every value from the
# Kyros client registration you received.
AEGIS_KYROS_ENABLED=false
AEGIS_KYROS_ISSUER=
AEGIS_KYROS_CLIENT_ID=
AEGIS_KYROS_CLIENT_SECRET=
AEGIS_KYROS_REDIRECT_URL=https://vpn.example.com/api/v1/auth/kyros/callback
AEGIS_KYROS_SCOPES=openid profile email
AEGIS_KYROS_BUTTON_LABEL=Se connecter avec Kyros
# Only for development against a staging issuer with a self-signed certificate.
AEGIS_KYROS_SKIP_ISSUER_CHECK=false

# ------------------------------------------------------------- wireguard
AEGIS_WG_INTERFACE=wg0
# Outbound interface used for the MASQUERADE rule. Leave empty to detect it
# from the kernel default route (Linux only).
AEGIS_WG_EGRESS_IFACE=
AEGIS_WG_PORT=51820
AEGIS_WG_NETWORK=10.77.0.0/24
AEGIS_WG_ENDPOINT=vpn.example.com:51820
AEGIS_WG_DNS=1.1.1.1,1.0.0.1
AEGIS_WG_MAX_PEERS=128
AEGIS_WG_PROFILE_TTL_HOURS=0
AEGIS_WG_FULL_TUNNEL=true
AEGIS_WG_KEEPALIVE=25
AEGIS_WG_IPV6=false

# ---------------------------------------------------------------- agent
# Socket the panel connects to...
AEGIS_AGENT_SOCKET=/run/aegis/agent.sock
# ...and the address the agent listens on (unix:///path or tcp://127.0.0.1:port).
AEGIS_AGENT_LISTEN=unix:///run/aegis/agent.sock
# Shared secret between panel and agent. Required when the agent listens on
# tcp://; recommended even on a unix socket.
# Generate with:  openssl rand -hex 32
AEGIS_AGENT_TOKEN=
AEGIS_AGENT_TIMEOUT=10s

# Egress (download) shaping with tc. Off by default: see docs/security.md.
AEGIS_RATE_LIMIT_ENABLED=false

# -------------------------------------------------------------- collector
AEGIS_USAGE_INTERVAL=1m
AEGIS_QUOTA_AUTO_SUSPEND=true
AEGIS_MAX_DEVICES_DEFAULT=5
